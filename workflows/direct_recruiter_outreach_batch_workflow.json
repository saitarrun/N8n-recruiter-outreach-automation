{
  "id": "T5xzFPEkCQ3vjclr",
  "name": "Direct Recruiter Outreach Sender",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "send-recruiter-outreach",
        "responseMode": "lastNode",
        "options": {}
      },
      "id": "node-webhook",
      "name": "Webhook Trigger",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        100,
        300
      ],
      "webhookId": "send-recruiter-outreach-webhook"
    },
    {
      "parameters": {
        "jsCode": "const body = $('Webhook Trigger').first().json.body;\nconst firstName = body.firstName || 'Recruiter';\nconst company = body.company || 'Company';\nconst targetEmail = body.email;\n\nlet subject = body.customSubject || `Software Engineering Opportunities at ${company} \u2014 Sai Tarrun Pitta`;\nlet htmlBody = body.customHtml || `<p>Hi ${firstName},</p><p>I am exploring engineering roles at ${company}.</p>`;\n\nlet binaryObj = {};\nif (body.resumeBase64) {\n  binaryObj = {\n    resume: {\n      data: body.resumeBase64,\n      mimeType: 'application/pdf',\n      fileName: body.resumeFileName || 'Sai_Tarrun_Pitta_Resume.pdf'\n    }\n  };\n}\n\nreturn {\n  json: {\n    success: true,\n    sendTo: targetEmail,\n    subject: subject,\n    htmlBody: htmlBody\n  },\n  binary: binaryObj\n};"
      },
      "id": "node-prep-email",
      "name": "Prepare Email Content",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        360,
        300
      ]
    },
    {
      "parameters": {
        "sendTo": "={{ $json.sendTo }}",
        "subject": "={{ $json.subject }}",
        "emailType": "html",
        "message": "={{ $json.htmlBody }}",
        "options": {
          "appendAttribution": false,
          "attachmentsUi": {
            "attachmentsBinary": [
              {
                "property": "resume"
              }
            ]
          }
        }
      },
      "id": "node-gmail-send",
      "name": "Gmail - Send Outreach",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
      "position": [
        620,
        300
      ],
      "credentials": {
        "gmailOAuth2": {
          "id": "7fLoFGrSYD2DCo0i",
          "name": "Gmail OAuth2 account"
        }
      },
      "webhookId": "e1fc3475-d9bf-4b31-91b2-8cb9663f4c51",
      "continueOnFail": false,
      "retryOnFail": true,
      "maxTries": 2
    }
  ],
  "connections": {
    "Webhook Trigger": {
      "main": [
        [
          {
            "node": "Prepare Email Content",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Prepare Email Content": {
      "main": [
        [
          {
            "node": "Gmail - Send Outreach",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  }
}